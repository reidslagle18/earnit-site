# Meta (Facebook) ads tracking — create a Pixel/Dataset in Meta Events Manager
# (business.facebook.com/events_manager). Site works fine with these unset;
# tracking silently no-ops.
NEXT_PUBLIC_META_PIXEL_ID=
# Events Manager → your Pixel → Settings → Conversions API → Generate access token
META_CAPI_ACCESS_TOKEN=
# Optional: Test Events tab code (e.g. TEST12345) while verifying setup. Remove in prod.
META_TEST_EVENT_CODE=

# Where CTAs send people. Set the App Store URL once the app is published —
# it takes priority. Until then CTAs fall back to the web signup.
# e.g. https://apps.apple.com/us/app/earnit/idXXXXXXXXXX
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_SIGNUP_URL=https://parentalcontrol-one.vercel.app/signup
